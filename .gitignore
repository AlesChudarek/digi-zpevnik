# Obsah zpěvníků do gitu nepatří. Zdrojem pravdy je server: zpěvníky vytvořené přes web
# existují jen tam, takže verzovaná kopie stejně nikdy nebyla úplná a jen se rozcházela.
# Bylo to 1253 obrázků a 816 MB v historii.
data/

# Zálohy dat ze serveru. Vlastní .git uvnitř je štít proti git clean -xdf.
zalohy/
ke-kontrole/

# Zmenšené náhledy obálek - odvozená data, generují se samy.
data/nahledy/

# Dosloužené nástroje. Jednorázové migrace, které proběhly a znovu se pustit nedají, plus
# povysit_obalky.py, které hledá varianty coverXT.png - tak se soubory po migraci úložiště
# nejmenují. Lokálně zůstávají, do gitu ani na server nepatří; co dělaly, je v historii.
backend/scripts/migrate_non_song_pages.py
backend/scripts/migrace_poradi_stran.py
backend/scripts/migrace_uloziste.py
backend/scripts/migrace_tabulka_images.py
backend/scripts/rebuild_private_from_fs.py
backend/scripts/povysit_obalky.py

# Seedování zaniklo. Reprodukovatelnost veřejných zpěvníků z gitu skončila ve chvíli, kdy
# je začal zakládat web - seedy nikdy neuměly zpěvník vytvořený přes UI. Obnovu dnes dělá
# denní záloha, která je úplná. seed_db.py navíc potřeboval obrázky ve staré struktuře,
# a ty už nejsou; init_db.py na něm stál a mazal přitom DB i data/private/users;
# create_songbook_db.sql drží schéma bez tabulky images.
backend/scripts/seed_db.py
backend/scripts/generate_public_seed.py
backend/scripts/create_songbook_db.sql
backend/init_db.py

# Pipeline pro úklid obrázků a nahrání na server. Pracovala s data/public/images/songbooks
# a volala povysit_obalky.py - obojí zaniklo migrací úložiště.
scripts/uklid-a-nahrat.sh
